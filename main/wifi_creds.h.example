/* Copy to main/wifi_creds.h and fill in your network and agent token.
 *
 * That file is gitignored, and discus_creds.h picks it up automatically via
 * __has_include, overriding the (empty) menuconfig defaults at build time.
 * Keeping credentials here rather than in sdkconfig means they never reach
 * version control.
 *
 * NOTE: after creating wifi_creds.h for the first time, run
 *   touch main/discus_creds.h
 * before building. The object files were compiled when this header did not
 * exist, so ninja has no recorded dependency on it and will not rebuild.
 */
#pragma once

#define DISCUS_WIFI_SSID_OVERRIDE     "your-ssid"
#define DISCUS_WIFI_PASSWORD_OVERRIDE "your-password"

/* Shared secret for the agent; must equal the agent's DISCUS_TOKEN. Generate
 * one with:  python3 -c 'import secrets; print(secrets.token_urlsafe(24))' */
#define DISCUS_AGENT_TOKEN_OVERRIDE   "your-agent-token"
